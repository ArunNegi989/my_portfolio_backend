{
  "name": "my-portfolio-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API, authentication and content management backend for the my-portfolio-frontend Next.js site.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
