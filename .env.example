# ---------------------------------------------------------------------------
# my-portfolio-backend configuration
# Copy to .env and fill in the values. Never commit .env.
# Generate the secrets with:  npm run generate-secrets
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development
# LOG_LEVEL=info
# Number of reverse proxies in front of the API (1 on Render/Railway/Heroku/Nginx), for correct client IPs in rate limiting.
TRUST_PROXY=0

# --- Database (required) ----------------------------------------------------
# MongoDB Atlas: Database → Connect → Drivers → copy the connection string.
MONGODB_URI=mongodb+srv://arunnegi989_db_user:<db_password>@portfolio.zc11knz.mongodb.net/?compressors=zlib

# --- URLs (required) --------------------------------------------------------
# Where the Next.js site runs. Used for CORS, the allowed request origin and password-reset links.
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma separated (e.g. a preview deployment). Optional.
CORS_ORIGINS=
# Public URL of THIS API, used to build links to uploaded files. Required in production.
BACKEND_PUBLIC_URL=http://localhost:5000

# --- JWT (required, at least 32 characters each, different values) ----------
JWT_ACCESS_SECRET=sdkjasgdGJKGJSGJK98SAFGjksfkjsfjhkgkasbkasbuwrkbsflsafjbbasjasfkjsafjasf
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=asfetoisfnlkansgkas8SAJKHSAFHKJBASlhsaOjkasfbDFBASFBASFKJKJBSFFJBASFKJB
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies -----------------------------------------------------------------
# lax  : frontend and API on the same site (localhost:3000 + localhost:5000, or example.com + api.example.com)
# none : frontend and API on different sites (requires HTTPS; CSRF protection stays on)
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production. Must be true for SameSite=none.
# COOKIE_SECURE=true
# Share cookies across subdomains, e.g. .example.com (optional).
COOKIE_DOMAIN=

# --- Email (Gmail SMTP with an App Password) ---------------------------------
# Required in production (password reset). Port 465 + SMTP_SECURE=true, or port 587 + SMTP_SECURE=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=arunnegi989@gmail.com
SMTP_APP_PASSWORD=smtx fhof woch jzsc
# e.g. "Arun Negi Portfolio <you@gmail.com>" (Gmail requires the address to be SMTP_USER or a verified alias)
EMAIL_FROM=arunnegi989@gmail.com
# Where contact-form notifications go (defaults to SMTP_USER).
CONTACT_NOTIFY_EMAIL=arunnegi989@gmail.com

# --- Frontend cache refresh (recommended) -----------------------------------
# Same value as REVALIDATE_SECRET in my-portfolio-frontend/.env.local. At least 32 characters.
REVALIDATE_SECRET=asgasgadgsdgfdhshgfjkhkSDGSDGDSHFHGFJ36ahshdHKgdFKvfhvVFHJvfjas
# Override if the API should call the frontend on an internal URL (default: FRONTEND_URL/api/revalidate).
FRONTEND_REVALIDATE_URL=http://localhost:3000

# --- Accounts ---------------------------------------------------------------
# Public signup creates accounts WITHOUT dashboard access. Set to false to close registration.
ALLOW_PUBLIC_SIGNUP=true
PASSWORD_RESET_TTL_MINUTES=30

# Used only by `npm run create-admin` (one-time bootstrap). Remove the password after running it.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=5242880
MAX_DOCUMENT_BYTES=10485760
